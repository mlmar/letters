---
import '#/styles/style.less';
import '#/styles/game.less';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>letters</title>
  </head>
  <body>
    <main id="main" class="flex-col middle center">
      <section class="flex fit game-header">
        <label data-game-score> 0 </label>
        <label data-game-lives> 0 &#9829; </label>
        <button data-restart-btn> Restart Game </button>
      </section>
      <label data-game-over-message></label>
      <div id="game-container" class="flex-col"> </div>
      <input data-game-input type="text" autofocus placeholder="type here"/>
    </main>
  </body>
</html>

<script>
  import { Game } from '#/game/game';

  const game = new Game('#game-container');
  game.start();

  const restartButton = document.querySelector('[data-restart-btn]');
  if (restartButton) {
    restartButton.addEventListener('click', () => {
      game.start();
    });
  }
</script>
